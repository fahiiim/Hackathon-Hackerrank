options:
  -h, --help            show this help message and exit
  --stage0 STAGE0
  --stage1 STAGE1
  --tokenizer TOKENIZER
  --maps MAPS
  --device {auto,cpu,cuda}
  --min-edit-prob MIN_EDIT_PROB
  --edit-margin EDIT_MARGIN
  --cases CASES         JSONL held-out cases; defaults to the 16-case smoke
                        suite
